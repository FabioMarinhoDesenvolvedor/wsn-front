{
  "name": "wsn",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply wsn --local",
    "db:migrate:remote": "wrangler d1 migrations apply wsn --remote",
    "db:seed:local": "node scripts/build-seed.mjs && wrangler d1 execute wsn --local --file=migrations/seed/catalog.sql",
    "db:seed:remote": "node scripts/build-seed.mjs && wrangler d1 execute wsn --remote --file=migrations/seed/catalog.sql",
    "images": "node scripts/build-images.mjs",
    "admin:link": "node scripts/admin-link.mjs",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^0.540.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@eslint/js": "^9.33.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "~4.1.11",
    "wrangler": "^4.148.0"
  },
  "allowScripts": {
    "sharp@0.35.2": true,
    "sharp@0.35.4": true,
    "sharp@0.34.5": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261006.1": true,
    "esbuild@0.28.1": true
  }
}
